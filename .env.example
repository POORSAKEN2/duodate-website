# true  = store badges link to the App Store / Google Play
# false = store badges open the "Join waitlist" modal
NEXT_PUBLIC_PUBLIC_RELEASE=false

# -----------------------------------------------------------------------------
# Supabase Connection (Required for /admin dashboard & download tracking)
# Find these in Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_!)
# Used exclusively in Next.js Server Components & API routes to read analytics
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Admin Dashboard Authentication
# -----------------------------------------------------------------------------
# Password required to sign in at /admin/login
ADMIN_DASHBOARD_PASSWORD=change-me-to-a-strong-password

# Random 32+ char secret used to sign the HttpOnly admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-secret

# Optional: shared secret for mobile app -> website analytics ingestion API
ANALYTICS_INGEST_SECRET=optional-ingest-secret
